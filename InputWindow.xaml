<Window x:Class="Id4Countdown.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Imposta Countdown"
        Width="300" Height="220"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Ore:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="HoursBox" Width="150" Text="0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Minuti:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="MinutesBox" Width="150" Text="0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Secondi:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="SecondsBox" Width="150" Text="0"/>
        </StackPanel>

        <Button Grid.Row="3"
                Content="Avvia"
                Height="35"
                Width="120"
                HorizontalAlignment="Center"
                Click="Start_Click"/>
    </Grid>
</Window>
