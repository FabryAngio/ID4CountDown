<Window x:Class="Id4Countdown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ID4 Countdown"
        Width="1000" Height="320"
        WindowStartupLocation="CenterScreen"
        Background="#202020"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Topmost="True">
    <Grid Margin="20">
        <Border Background="#101010"
                BorderBrush="#707070"
                BorderThickness="2">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra superiore con "Time Remaining" -->
                <DockPanel Grid.Row="0" LastChildFill="False">
                    <TextBlock Text="Time Remaining"
                               Foreground="#E0E0E0"
                               FontFamily="Segoe UI"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="4,0,0,2"/>

                    <!-- Finti pulsanti finestra -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right"
                                Margin="0,0,4,0">
                        <Rectangle Width="12" Height="12" Stroke="#808080" Margin="2"/>
                        <Rectangle Width="12" Height="12" Stroke="#808080" Margin="2"/>
                        <Rectangle Width="12" Height="12" Stroke="#808080" Margin="2"/>
                    </StackPanel>
                </DockPanel>

                <!-- Display countdown -->
<Border Grid.Row="1"
        Margin="0,6,0,0"
        Background="Black"
        BorderBrush="#303030"
        BorderThickness="2">
<Viewbox Stretch="Uniform">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

<!-- ORE -->
<TextBlock x:Name="HoursBlock"
           Text="00"
           Foreground="#00E600"
           FontSize="120"
           Width="110"
           TextAlignment="Right"
           FontFamily="pack://application:,,,/Fonts/#Digital-7"/>

<!-- : -->
<TextBlock Text=":"
           Foreground="#00E600"
           FontSize="120"
           Width="30"
           TextAlignment="Center"
           FontFamily="pack://application:,,,/Fonts/#Digital-7"/>

<!-- MINUTI -->
<TextBlock x:Name="MinutesBlock"
           Text="00"
           Foreground="#00E600"
           FontSize="120"
           Width="110"
           TextAlignment="Right"
           FontFamily="pack://application:,,,/Fonts/#Digital-7"/>

<!-- : -->
<TextBlock Text=":"
           Foreground="#00E600"
           FontSize="120"
           Width="30"
           TextAlignment="Center"
           FontFamily="pack://application:,,,/Fonts/#Digital-7"/>

<!-- SECONDI -->
<TextBlock x:Name="SecondsBlock"
           Text="00"
           Foreground="#00E600"
           FontSize="120"
           Width="110"
           TextAlignment="Right"
           FontFamily="pack://application:,,,/Fonts/#Digital-7"/>

<!-- Centesimi più piccoli -->
<TextBlock x:Name="CentiBlock"
           Text=":00"
           Foreground="#00E600"
           FontSize="60"
           Width="70"
           Margin="20,35,0,0"
           VerticalAlignment="Center"
           FontFamily="pack://application:,,,/Fonts/#Digital-7"/>

    </StackPanel>
</Viewbox>
</Border>
            </Grid>
        </Border>
    </Grid>
</Window>
